#!/usr/bin/env bash
# Stub browser opener for tests/smoke.sh, linked as both `open` (macOS) and
# `xdg-open` (Linux). `peasant open` opens the browser itself, so the plugin
# script must never call this: every call is recorded in the file named by
# PEASANT_STUB_BROWSER, and the smoke test fails when that file exists.
printf '%s\n' "$*" >> "$PEASANT_STUB_BROWSER"
